{
  "name": "acorn.css",
  "version": "3.0.0",
  "description": "A lightweight, classless CSS baseline that styles semantic HTML out of the box — the stylesheet you start with.",
  "license": "MIT",
  "author": "Jo Murgel",
  "type": "module",
  "main": "dist/acorn.css",
  "module": "dist/acorn.css",
  "style": "dist/acorn.css",
  "unpkg": "dist/acorn.min.css",
  "jsdelivr": "dist/acorn.min.css",
  "exports": {
    ".": {
      "style": "./dist/acorn.css",
      "default": "./dist/acorn.css"
    },
    "./min": {
      "style": "./dist/acorn.min.css",
      "default": "./dist/acorn.min.css"
    }
  },
  "files": [
    "dist/acorn.css",
    "dist/acorn.min.css",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:css",
    "build:css": "mkdir -p dist && cp src/acorn.css dist/acorn.css && esbuild src/acorn.css --minify --outfile=dist/acorn.min.css",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build:css"
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "esbuild": "^0.25.4",
    "vite": "^6.3.5"
  },
  "keywords": [
    "css",
    "classless",
    "semantic",
    "html",
    "stylesheet",
    "baseline",
    "lightweight",
    "markdown",
    "accessible",
    "dark-mode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomurgel/acorn.css.git"
  },
  "bugs": {
    "url": "https://github.com/jomurgel/acorn.css/issues"
  },
  "homepage": "https://jomurgel.github.io/acorn.css"
}
